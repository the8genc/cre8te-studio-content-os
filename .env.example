# Cre8te Studio Content OS — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env — it is in .gitignore.
#
# KEY SECURITY OPTIONS:
#   Local dev:     copy to .env, fill in values, .gitignore keeps it safe
#   CI/Automation: add each key to GitHub → Settings → Secrets and variables → Actions
#   Team use:      store in Doppler (doppler.com) — agents pull at runtime, no .env needed
#
# See docs/secret-management.md for setup guides for each option.

# ── Coda ──────────────────────────────────────────────────────────────────────
CODA_API_KEY=your_coda_api_key_here
CODA_DOC_ID=ktMUNdlobR

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Fireflies (transcription) ──────────────────────────────────────────────────
FIREFLIES_API_KEY=your_fireflies_api_key_here
FIREFLIES_GRAPHQL_ENDPOINT=https://api.fireflies.ai/graphql

# ── Apify (social scraping) ───────────────────────────────────────────────────
APIFY_API_KEY=your_apify_api_key_here

# ── Perplexity (web research) ──────────────────────────────────────────────────
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# ── Google Drive (source file storage) ────────────────────────────────────────
GOOGLE_DRIVE_CREDENTIALS_JSON=path/to/service-account.json
GOOGLE_DRIVE_SUMMIT_FOLDER_ID=your_summit_folder_id
GOOGLE_DRIVE_MINIPOD_FOLDER_ID=your_minipod_folder_id
GOOGLE_DRIVE_TESTIMONIAL_FOLDER_ID=your_testimonial_folder_id
GOOGLE_DRIVE_ITL_FOLDER_ID=your_itl_folder_id

# ── Postiz (social publishing) ────────────────────────────────────────────────
POSTIZ_API_KEY=your_postiz_api_key_here

# ── Kit (newsletter email) ────────────────────────────────────────────────────
KIT_API_KEY=your_kit_api_key_here

# ── ZeroDB (AINative Studio — agent memory / context sync) ────────────────────
# Every Coda write is mirrored to ZeroDB memory (session: cre8te-coda-sync).
# Get a key from https://api.ainative.studio — leave blank to skip ZeroDB writes.
ZERODB_API_KEY=your_zerodb_api_key_here
ZERODB_MCP_URL=https://api.ainative.studio/v1/mcp/zerodb-memory-mcp/messages

# Set to 1 to disable Coda → markdown/ZeroDB write mirroring entirely
# CODA_SYNC_DISABLED=1
