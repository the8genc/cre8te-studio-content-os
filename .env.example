# Cre8te Studio Content OS — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# ── Coda ──────────────────────────────────────────────────────────────────────
CODA_API_KEY=your_coda_api_key_here
CODA_DOC_ID=ktMUNdlobR
CODA_SOURCE_ASSETS_TABLE_ID=grid-_OYt6Tiix6
CODA_CONTENT_IDEAS_TABLE_ID=grid-dL_d_C7-B_
CODA_CONTENT_PACKAGES_TABLE_ID=grid-Tdc2ZycQ_i
CODA_NEWSLETTER_DRAFTS_TABLE_ID=grid-B1Ztf-NOaP
CODA_ANALYTICS_LOG_TABLE_ID=grid-mfuhm3UCSP
CODA_BRAND_VOICE_KB_TABLE_ID=grid-x2d3b0GQx4

# ── Fireflies ──────────────────────────────────────────────────────────────────
FIREFLIES_API_KEY=your_fireflies_api_key_here
FIREFLIES_GRAPHQL_ENDPOINT=https://api.fireflies.ai/graphql

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Google Drive ──────────────────────────────────────────────────────────────
GOOGLE_DRIVE_CREDENTIALS_JSON=path/to/credentials.json
GOOGLE_DRIVE_SUMMIT_FOLDER_ID=your_summit_folder_id
GOOGLE_DRIVE_MINIPOD_FOLDER_ID=your_minipod_folder_id
GOOGLE_DRIVE_TESTIMONIAL_FOLDER_ID=your_testimonial_folder_id
GOOGLE_DRIVE_ITL_FOLDER_ID=your_itl_folder_id

# ── Postiz (Social Publishing) ────────────────────────────────────────────────
POSTIZ_API_KEY=your_postiz_api_key_here
POSTIZ_API_URL=https://api.postiz.com

# ── Kit (Newsletter Email) ────────────────────────────────────────────────────
KIT_API_KEY=your_kit_api_key_here
KIT_API_URL=https://api.kit.com/v4

# ── DaVinci Resolve (optional, for local editor integration) ──────────────────
RESOLVE_SCRIPT_API=/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting
RESOLVE_SCRIPT_LIB=/Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Libraries/Fusion/fusionscript.so
