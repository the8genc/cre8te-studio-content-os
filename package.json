{
  "name": "cre8te-studio-content-os",
  "version": "1.0.0",
  "description": "AI-powered content operating system for Cre8te Studio — 8 agents in TypeScript/Node",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "ingester": "tsx agents/01-ingester/ingester.ts",
    "transcriber": "tsx agents/02-transcriber/transcriber.ts",
    "strategist": "tsx agents/03-content-strategist/strategist.ts",
    "writer": "tsx agents/04-content-writer/writer.ts",
    "newsletter": "tsx agents/05-newsletter-editor/newsletter.ts",
    "publisher": "tsx agents/06-publisher/publisher.ts",
    "analyst": "tsx agents/07-analyst/analyst.ts",
    "scout": "tsx agents/08-research-scout/scout.ts",
    "pipeline": "tsx agents/full-pipeline.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx agents/09-testing-agent/testing-agent.ts",
    "test:scout": "tsx tests/agents/test-scout.ts",
    "test:strategist": "tsx tests/agents/test-strategist.ts",
    "test:writer": "tsx tests/agents/test-writer.ts",
    "test:newsletter": "tsx tests/agents/test-newsletter.ts",
    "test:agent": "tsx agents/09-testing-agent/testing-agent.ts",
    "test:agent:weekly": "tsx agents/09-testing-agent/testing-agent.ts --weekly",
    "test:agent:deploy": "tsx agents/09-testing-agent/testing-agent.ts --post-deploy",
    "test:approval-loop": "tsx tests/integration/test-approval-loop.ts",
    "test:publisher": "tsx tests/phase3/test-publisher.ts",
    "test:full-pipeline": "tsx tests/integration/test-full-pipeline.ts",
    "test:phase2": "tsx tests/run-phase2.ts",
    "test:phase3": "npx tsx tests/phase3/test-publisher.ts",
    "test:integration": "npx tsx tests/integration/test-approval-loop.ts && npx tsx tests/integration/test-full-pipeline.ts",
    "add-playbook-columns": "tsx scripts/add-playbook-columns.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "googleapis": "^140.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
